{
  "compilerOptions": {
    /* Environment */
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    /* Output */
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    /* Type safety */
    "strict": true,
    "skipLibCheck": true,
    /* Node */
    "types": [
      "node"
    ],
    /* Decorators (bắt buộc cho class-validator, Prisma DTO) */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    /* Quan trọng */
    "verbatimModuleSyntax": false
  }
}